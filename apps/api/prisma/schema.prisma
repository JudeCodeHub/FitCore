generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  FRONT_DESK
  MEMBER
}

model User {
  id                          String       @id @default(cuid())
  role                        UserRole
  name                        String
  email                       String       @unique
  passwordHash                String
  phone                       String?
  qrCodeId                    String       @unique @default(cuid())
  emailVerified               Boolean      @default(false)
  verificationToken           String?      @unique
  verificationTokenExpiresAt  DateTime?
  resetToken                  String?      @unique
  resetTokenExpiresAt         DateTime?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  sessions                    Session[]
  memberships                 Membership[]
  dependentOf                 MembershipDependent?
  taughtClasses               Class[]
  bookings                    Booking[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  userAgent    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique

  @@index([userId])
}

model StaffInvite {
  id        String    @id @default(cuid())
  email     String
  role      UserRole
  token     String    @unique
  invitedBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum PlanDuration {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Plan {
  id          String       @id @default(cuid())
  name        String
  price       Decimal      @db.Decimal(10, 2)
  duration    PlanDuration
  features    String[]
  /// Total people this plan covers, owner included. 1 = individual plan.
  maxMembers  Int          @default(1)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

enum MembershipStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
  PENDING
}

model Membership {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan                 @relation(fields: [planId], references: [id])
  status      MembershipStatus     @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  frozenUntil DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  freezes     MembershipFreeze[]
  dependents  MembershipDependent[]

  @@index([userId])
  @@index([planId])
}

/// Another user linked under an owner's membership (family/group plan).
/// The dependent doesn't have their own separate Membership — they ride
/// on the owner's, up to the owner's plan.maxMembers.
model MembershipDependent {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@index([membershipId])
}

model MembershipFreeze {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

model Class {
  id             String    @id @default(cuid())
  name           String
  trainerId      String
  trainer        User      @relation(fields: [trainerId], references: [id])
  capacity       Int
  startTime      DateTime
  endTime        DateTime
  /// iCal-style rule (e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR") for the recurring
  /// class template generator; null means a one-off session.
  recurrenceRule String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([trainerId])
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  classId     String
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now())
  cancelledAt DateTime?

  @@index([classId])
  @@index([userId])
}
